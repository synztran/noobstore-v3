{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "ProductReview",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"description": "Unique identifier for the review"
		},
		"productId": {
			"type": "string",
			"description": "ID of the reviewed product"
		},
		"userId": {
			"type": "string",
			"description": "ID of the user who wrote the review"
		},
		"userName": {
			"type": "string",
			"description": "Display name of the reviewer"
		},
		"userAvatar": {
			"type": "string",
			"description": "URL to user's avatar image"
		},
		"rating": {
			"type": "integer",
			"minimum": 1,
			"maximum": 5,
			"description": "Star rating from 1 to 5"
		},
		"title": {
			"type": "string",
			"maxLength": 100,
			"description": "Review title/summary"
		},
		"comment": {
			"type": "string",
			"maxLength": 1000,
			"description": "Detailed review comment"
		},
		"images": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "Array of image URLs attached to the review"
		},
		"status": {
			"type": "string",
			"enum": ["PENDING", "APPROVED", "REJECTED"],
			"description": "Review moderation status"
		},
		"isVerifiedPurchase": {
			"type": "boolean",
			"description": "Whether the reviewer actually purchased the product"
		},
		"helpfulCount": {
			"type": "integer",
			"minimum": 0,
			"description": "Number of users who found this review helpful"
		},
		"createdAt": {
			"type": "string",
			"format": "date-time",
			"description": "Review creation timestamp"
		},
		"updatedAt": {
			"type": "string",
			"format": "date-time",
			"description": "Review last update timestamp"
		}
	},
	"required": ["productId", "userId", "rating", "status"]
}
